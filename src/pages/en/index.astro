---
import Layout from '../../layouts/Layout.astro';
import RecentCommits from '../../components/react/RecentCommits';
import RecentThought from '../../components/react/RecentThought';
import { fetchRecentBlogPost } from '../../lib/recentBlog';

const recentPost = await fetchRecentBlogPost();
---

<Layout title="why so serious" lang="en">
  <div class="page-wrap">

    <!-- hero: 3 cols -->
    <div class="hero">
      <div class="avatar">
        <img src="/logo.jpg" alt="ysoseri" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
      </div>

      <div class="hero-bio">
        <div class="hero-name">ysoseri</div>
        <div class="hero-desc">Currently studying for a Master's degree at the University of Auckland; (not quite) a full-stack vibe coding developer; enjoy building some little wheels; enjoy photographing daily life and exploring new technology stacks; a power user and loyal fan of Claude; now on a nine-to-five intern</div>
        <div class="hero-meta">
          <div class="hero-tag">📍 <b>Auckland</b> → Shandong</div>
          <div class="hero-tag">🎓 MInfoTech @ UoA</div>
        </div>
      </div>

      <div class="commit-panel">
        <div class="panel-label">Recent commits</div>
        <RecentCommits client:visible />
      </div>
    </div>

    <!-- snake contribution -->
    <div class="snake-section">
      <div class="snake-ph">
        <div class="snake-ph-label">Activities</div>
        <img class="snake-img" src="/github-snake-light.svg" alt="GitHub contribution snake" data-light="/github-snake-light.svg" data-dark="/github-snake-dark.svg" onerror="this.parentElement.innerHTML='<div class=\'snake-ph-inner\'>Loading contribution graph…</div>'" />
      </div>
    </div>

    <!-- main grid: md-area + sidebar -->
    <div class="main-grid">
      <div class="md-area">
        <div class="panel-label" style="margin-bottom:1.25rem">About</div>
        <div class="md-content">
          <h2>Background</h2>
          <p>B.Sc. Computer Science, Qilu Normal University. Currently an MInfoTech student at the University of Auckland, focusing on full-stack development, security engineering, and machine learning.</p>
          <h2>Currently</h2>
          <ul>
            <li><a href="https://blog.ysoseri.us/internship/">Interning</a></li>
            <li><a href="https://travel.ysoseri.us">Travel Map</a></li>
            <li><a href="https://luckyrong.ysoseri.us">In a Relationship</a></li>
          </ul>
          <h2>Technical</h2>
          <ul>
            <li>Full-Stack Development: JavaScript / TypeScript (MERN Stack, Astro, Next.js, Vite, Tailwind CSS, Electron), Python (Django, FastAPI, Flask, PyTorch, Transformers, pandas)</li>
            <li>Cloud Development: Cloudflare (Pages, Workers, D1, R2), AWS (Bedrock, DynamoDB, Lambda, S3)</li>
            <li>Databases: MySQL, PostgreSQL, SQLite, MongoDB</li>
            <li>Automation &amp; Testing: Playwright, pytest, Vitest, Supertest, GitHub Actions</li>
            <li>Cybersecurity: web vuln analysis, penetration testing, just another CTFer</li>
            <li>AI Development Tools: Claude Code, OpenAI Codex, GitHub Copilot</li>
            <li>Documentation &amp; Collaboration: Obsidian, Microsoft Office, LaTeX, Google Docs, Yuque, Shimo Docs, Notion</li>
          </ul>
          <h2>Selected projects</h2>
          <ul>
            <li><a href="https://github.com/Ysoseri1224/UoA-CompSci-732-Proj-Archive" target="_blank" rel="noreferrer"><code>UoA-CompSci-732-Proj-Archive</code></a> — COMPSCI 732 team project built with React, Express, MongoDB, Socket.IO, and Docker</li>
            <li><a href="https://github.com/Ysoseri1224/Fully-Auto-Docx-Format-Process" target="_blank" rel="noreferrer"><code>Fully-Auto-Docx-Format-Process</code></a> — DOCX template reuse and AI review workbench built with Electron, OOXML, and Rust</li>
            <li><a href="https://github.com/Ysoseri1224/CET-6-training-camp" target="_blank" rel="noreferrer"><code>CET-6-training-camp</code></a> — CET-6 English training platform built with Vite and React, deployed on Cloudflare Pages</li>
            <li><a href="https://github.com/Ysoseri1224/Course_schedule" target="_blank" rel="noreferrer"><code>Course_schedule</code></a> — Independently delivered scheduling desktop app for a training institution, built with Electron, React, and SQLite</li>
            <li><a href="https://github.com/Ysoseri1224/Visual-Data-Analysis-of-Popular-Video-Platforms" target="_blank" rel="noreferrer"><code>Visual-Data-Analysis-of-Popular-Video-Platforms</code></a> — Video-platform data collection and visual analytics with FastAPI, Next.js, MongoDB, and MySQL</li>
            <li><a href="https://github.com/Ysoseri1224/timeline" target="_blank" rel="noreferrer"><code>timeline</code></a> — Paper-like relationship timeline built with Astro, React, GSAP, D1, and R2</li>
          </ul>
        </div>
      </div>

      <div class="sidebar">
        <div>
          <div class="sb-label">Recent thoughts</div>
          <RecentThought lang="en" initialPost={recentPost} client:load />
        </div>
        <div>
          <div class="sb-label">Quick access</div>
          <div class="quick-links">
            <a class="quick-link ql-accent" href="https://github.com/Ysoseri1224" target="_blank">
              <span class="ql-text">GitHub</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/sub-recorder" target="_blank">
              <span class="ql-text">sub-recorder</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/course-kb-skill" target="_blank">
              <span class="ql-text">course-kb-skill</span><span class="ql-arr">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import RecentCommits from '../../components/react/RecentCommits';
---

<Layout title="ysoseri" lang="en">
  <div class="page-wrap">

    <!-- hero: 3 cols -->
    <div class="hero">
      <div class="avatar">
        <img src="/logo.jpg" alt="ysoseri" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
      </div>

      <div class="hero-bio">
        <div class="hero-name">ysoseri</div>
        <div class="hero-desc">Currently studying for a Master's degree at the University of Auckland; (not quite) a full-stack vibe coding developer; enjoy building some little wheels; enjoy photographing daily life and exploring new technology stacks; a power user and loyal fan of Claude; now on a nine-to-five intern</div>
        <div class="hero-meta">
          <div class="hero-tag">📍 <b>Auckland</b> → Shandong</div>
          <div class="hero-tag">🎓 MInfoTech @ UoA</div>
        </div>
      </div>

      <div class="commit-panel">
        <div class="panel-label">Recent commits</div>
        <RecentCommits client:visible />
      </div>
    </div>

    <!-- snake contribution -->
    <div class="snake-section">
      <div class="snake-ph">
        <div class="snake-ph-label">Activities</div>
        <img class="snake-img" src="/github-snake-light.svg" alt="GitHub contribution snake" data-light="/github-snake-light.svg" data-dark="/github-snake-dark.svg" onerror="this.parentElement.innerHTML='<div class=\'snake-ph-inner\'>Loading contribution graph…</div>'" />
      </div>
    </div>

    <!-- main grid: md-area + sidebar -->
    <div class="main-grid">
      <div class="md-area">
        <div class="panel-label" style="margin-bottom:1.25rem">About</div>
        <div class="md-content">
          <h2>Background</h2>
          <p>B.Sc. Computer Science, Qilu Normal University. Currently an MInfoTech student at the University of Auckland, focusing on full-stack development, security engineering, and machine learning.</p>
          <h2>Currently</h2>
          <ul>
            <li><a href="https://travel.ysoseri.us">Travel Map</a></li>
            <li><a href="https://luckyrong.ysoseri.us">In a Relationship</a></li>
          </ul>
          <h2>Technical</h2>
          <ul>
            <li>Full-Stack: MERN, FastAPI, Django, Flask</li>
            <li>Cybersecurity: web vuln analysis, penetration testing, unnamed CTFer</li>
            <li>Databases: MySQL, PostgreSQL, SQLite, MongoDB, Oracle</li>
            <li>AI Tools: Claude code</li>
          </ul>
          <h2>Selected projects</h2>
          <ul>
            <li><code>course-schedule</code> — Full-stack scheduling system for an IELTS institution (MERN), independently delivered</li>
            <li><code>CET-6-training-camp</code> — Vocabulary trainer for the CET-6 exam, Vite + React, on CF Pages</li>
            <li><code>together-time-app</code> — Couples interaction app, esbuild + CF Worker + D1</li>
            <li><code>Visual-Data-Analysis</code> — Video platform data visualisation, FastAPI + frontend, 92/100 final year project</li>
          </ul>
        </div>
      </div>

      <div class="sidebar">
        <div>
          <div class="sb-label">Latest post</div>
          <a class="blog-card" href="https://blog.ysoseri.us" target="_blank">
            <div class="blog-title">Blog coming soon…</div>
            <div class="blog-date">blog.ysoseri.us · soon</div>
          </a>
        </div>
        <div>
          <div class="sb-label">Quick access</div>
          <div class="quick-links">
            <a class="quick-link ql-accent" href="https://github.com/Ysoseri1224" target="_blank">
              <span class="ql-text">GitHub</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/CET-6-training-camp" target="_blank">
              <span class="ql-text">CET-6-training-camp</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/Fully-Auto-Docx-Format-Process" target="_blank">
              <span class="ql-text">Fully-Auto-Docx</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/sub-recorder" target="_blank">
              <span class="ql-text">sub-recorder</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/together-time-app" target="_blank">
              <span class="ql-text">together-time-app</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/course-kb-skill" target="_blank">
              <span class="ql-text">course-kb-skill</span><span class="ql-arr">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import RecentCommits from '../../components/react/RecentCommits';
---

<Layout title="ysoseri" lang="zh">
  <div class="page-wrap">

    <!-- hero: 3 cols -->
    <div class="hero">
      <div class="avatar">
        <img src="/logo.jpg" alt="ysoseri" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
      </div>

      <div class="hero-bio">
        <div class="hero-name">ysoseri</div>
        <div class="hero-desc">奥克兰大学在读硕士，（不完全是）全栈vibe coding开发者，喜欢自己搞点生产力小工具，乐于记录生活，接触新的技术栈，Claude深度用户和忠实粉丝，现朝九晚五实习中</div>
        <div class="hero-meta">
          <div class="hero-tag">📍 <b>奥克兰</b> → 待定</div>
          <div class="hero-tag">🎓 信息技术硕士 @ UoA</div>
        </div>
      </div>

      <div class="commit-panel">
        <div class="panel-label">最近提交</div>
        <RecentCommits client:visible />
      </div>
    </div>

    <!-- snake contribution -->
    <div class="snake-section">
      <div class="snake-ph">
        <div class="snake-ph-label">动态</div>
        <img class="snake-img" src="/github-snake-light.svg" alt="GitHub 贡献蛇" data-light="/github-snake-light.svg" data-dark="/github-snake-dark.svg" onerror="this.parentElement.innerHTML='<div class=\'snake-ph-inner\'>贡献动画生成中……</div>'" />
      </div>
    </div>

    <!-- main grid: md-area + sidebar -->
    <div class="main-grid">
      <div class="md-area">
        <div class="panel-label" style="margin-bottom:1.25rem">关于</div>
        <div class="md-content">
          <h2>背景</h2>
          <p>齐鲁师范学院计算机科学与技术（师范）本科毕业，现于奥克兰大学攻读信息技术硕士。主修方向涵盖全栈开发、网络安全与隐私工程、机器学习。</p>
          <h2>近况</h2>
          <p>奥克兰大学在读研究生，同时维护若干个人项目。计划毕业后留在新西兰或前往其他英语系城市从事全栈/安全相关工作。</p>
          <h2>技术栈</h2>
          <ul>
            <li>全栈开发：MERN stack、FastAPI、Django、Flask；完整交付能力，从需求到部署</li>
            <li>网络安全：全国大学生信息安全竞赛一等奖（2023）；Web 漏洞分析、渗透测试、网络防御</li>
            <li>数据库：MySQL、PostgreSQL、SQLite、MongoDB、Oracle；关系型与非关系型均熟悉</li>
            <li>AI 辅助开发：Windsurf、Cursor、Claude、ChatGPT；AI 加速全栈交付与调试</li>
          </ul>
          <h2>项目</h2>
          <ul>
            <li><code>course-schedule</code> — 为 IELTS 培训机构独立交付的全栈排课系统（MERN）</li>
            <li><code>CET-6-training-camp</code> — 六级词汇训练营，Vite + React，部署于 CF Pages</li>
            <li><code>together-time-app</code> — 情侣互动小应用，esbuild + CF Worker + D1</li>
            <li><code>Visual-Data-Analysis</code> — 视频平台数据可视化，FastAPI + 前端，本科毕设 92/100</li>
          </ul>
        </div>
      </div>

      <div class="sidebar">
        <div>
          <div class="sb-label">最新文章</div>
          <a class="blog-card" href="https://blog.ysoseri.us" target="_blank">
            <div class="blog-title">博客建设中……</div>
            <div class="blog-date">blog.ysoseri.us · 敬请期待</div>
          </a>
        </div>
        <div>
          <div class="sb-label">快速访问</div>
          <div class="quick-links">
            <a class="quick-link ql-accent" href="https://github.com/Ysoseri1224" target="_blank">
              <span class="ql-text">GitHub</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/CET-6-training-camp" target="_blank">
              <span class="ql-text">CET-6-training-camp</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/Fully-Auto-Docx-Format-Process" target="_blank">
              <span class="ql-text">Fully-Auto-Docx</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/sub-recorder" target="_blank">
              <span class="ql-text">sub-recorder</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/together-time-app" target="_blank">
              <span class="ql-text">together-time-app</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/course-kb-skill" target="_blank">
              <span class="ql-text">course-kb-skill</span><span class="ql-arr">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import RecentCommits from '../../components/react/RecentCommits';
import RecentThought from '../../components/react/RecentThought';
import { fetchRecentBlogPost } from '../../lib/recentBlog';

const recentPost = await fetchRecentBlogPost();
---

<Layout title="why so serious" lang="zh">
  <div class="page-wrap">

    <!-- hero: 3 cols -->
    <div class="hero">
      <div class="avatar">
        <img src="/logo.jpg" alt="ysoseri" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
      </div>

      <div class="hero-bio">
        <div class="hero-name">ysoseri</div>
        <div class="hero-desc">奥克兰大学在读硕士，（不完全是）全栈vibe coding开发者，喜欢自己搞点生产力小工具，乐于记录生活，接触新的技术栈，Claude深度用户和忠实粉丝，现朝九晚五实习中</div>
        <div class="hero-meta">
          <div class="hero-tag">📍 <b>奥克兰</b> → 山东</div>
          <div class="hero-tag">🎓 信息技术硕士 @ UoA</div>
        </div>
      </div>

      <div class="commit-panel">
        <div class="panel-label">最近提交</div>
        <RecentCommits client:visible />
      </div>
    </div>

    <!-- snake contribution -->
    <div class="snake-section">
      <div class="snake-ph">
        <div class="snake-ph-label">动态</div>
        <img class="snake-img" src="/github-snake-light.svg" alt="GitHub 贡献蛇" data-light="/github-snake-light.svg" data-dark="/github-snake-dark.svg" onerror="this.parentElement.innerHTML='<div class=\'snake-ph-inner\'>贡献动画生成中……</div>'" />
      </div>
    </div>

    <!-- main grid: md-area + sidebar -->
    <div class="main-grid">
      <div class="md-area">
        <div class="panel-label" style="margin-bottom:1.25rem">关于</div>
        <div class="md-content">
          <h2>背景</h2>
          <p>齐鲁师范学院计算机科学与技术（师范）本科毕业，现于奥克兰大学攻读信息技术硕士。主修方向涵盖全栈开发、网络安全与隐私工程、机器学习。</p>
          <h2>近况</h2>
          <ul>
            <li><a href="https://travel.ysoseri.us">旅游地图</a></li>
            <li><a href="https://luckyrong.ysoseri.us">恋爱中</a></li>
          </ul>
          <h2>技术栈</h2>
          <ul>
            <li>全栈开发：JavaScript / TypeScript（MERN Stack、Astro、Next.js、Vite、Tailwind CSS、Electron）、Python（Django、FastAPI、Flask、PyTorch、Transformers、Pandas）</li>
            <li>云开发：Cloudflare（Pages、Workers、D1、R2）、AWS（Bedrock、DynamoDB、Lambda、S3）</li>
            <li>数据库：MySQL、PostgreSQL、SQLite、MongoDB</li>
            <li>自动化与测试：Playwright、pytest、Vitest、Supertest、GitHub Actions</li>
            <li>网络安全：Web 漏洞分析、渗透测试、无名的CTFer</li>
            <li>AI 开发工具：Claude Code、OpenAI Codex、GitHub Copilot</li>
            <li>文档及协作：Obsidian、Microsoft Office、LaTeX、Google Docs、语雀、石墨文档、Notion</li>
          </ul>
          <h2>项目</h2>
          <ul>
            <li><a href="https://github.com/Ysoseri1224/UoA-CompSci-732-Proj-Archive" target="_blank" rel="noreferrer"><code>UoA-CompSci-732-Proj-Archive</code></a> — COMPSCI 732 团队课程项目，React + Express + MongoDB + Socket.IO + Docker</li>
            <li><a href="https://github.com/Ysoseri1224/Fully-Auto-Docx-Format-Process" target="_blank" rel="noreferrer"><code>Fully-Auto-Docx-Format-Process</code></a> — DOCX 模板复用与 AI 审阅工作台，Electron + OOXML + Rust</li>
            <li><a href="https://github.com/Ysoseri1224/CET-6-training-camp" target="_blank" rel="noreferrer"><code>CET-6-training-camp</code></a> — 六级英语训练平台，Vite + React，部署于 Cloudflare Pages</li>
            <li><a href="https://github.com/Ysoseri1224/Course_schedule" target="_blank" rel="noreferrer"><code>Course_schedule</code></a> — 为培训机构独立交付的排课桌面应用，Electron + React + SQLite</li>
            <li><a href="https://github.com/Ysoseri1224/Visual-Data-Analysis-of-Popular-Video-Platforms" target="_blank" rel="noreferrer"><code>Visual-Data-Analysis-of-Popular-Video-Platforms</code></a> — 视频平台数据采集与可视化分析，FastAPI + Next.js + MongoDB / MySQL</li>
            <li><a href="https://github.com/Ysoseri1224/timeline" target="_blank" rel="noreferrer"><code>timeline</code></a> — 纸面关系时间轴，Astro + React + GSAP + D1 / R2</li>
          </ul>
        </div>
      </div>

      <div class="sidebar">
        <div>
          <div class="sb-label">近期思考</div>
          <RecentThought lang="zh" initialPost={recentPost} client:load />
        </div>
        <div>
          <div class="sb-label">快速访问</div>
          <div class="quick-links">
            <a class="quick-link ql-accent" href="https://github.com/Ysoseri1224" target="_blank">
              <span class="ql-text">GitHub</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/sub-recorder" target="_blank">
              <span class="ql-text">sub-recorder</span><span class="ql-arr">↗</span>
            </a>
            <a class="quick-link" href="https://github.com/Ysoseri1224/course-kb-skill" target="_blank">
              <span class="ql-text">course-kb-skill</span><span class="ql-arr">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Identity from '../../components/Identity.astro';
import ProjectCard from '../../components/react/ProjectCard';
import AnimatedSection from '../../components/react/AnimatedSection';
import RecentCommits from '../../components/react/RecentCommits';
import zh from '../../i18n/zh';
---

<Layout title={zh.title} lang="zh">
  <main class="mx-auto max-w-3xl px-6">
    <Identity lang="zh" />

    <!-- 项目列表 -->
    <section class="pb-16">
      <h2 class="text-sm font-medium text-[var(--color-text-muted)] uppercase tracking-wide mb-6">
        {zh.projects.heading}
      </h2>
      <div class="space-y-1">
        {zh.projects.items.map((project, i) => (
          <AnimatedSection client:visible delay={i * 0.06}>
            <ProjectCard
              client:visible
              name={project.name}
              description={project.description}
              tags={project.tags}
              url={project.url}
            />
          </AnimatedSection>
        ))}
      </div>
    </section>

    <!-- GitHub 最近动态 -->
    <section class="pb-20">
      <h2 class="text-sm font-medium text-[var(--color-text-muted)] uppercase tracking-wide mb-6">
        {zh.commits.heading}
      </h2>
      <RecentCommits client:visible lang="zh" />
    </section>
  </main>
</Layout>

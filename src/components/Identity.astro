---
interface Props {
  lang: string;
}

const { lang } = Astro.props;

const content = {
  zh: {
    lines: [
      '在奥克兰写代码、读研、偶尔发呆。',
      '做一些有趣的和没用的东西。',
      '相信好的工具应该是安静的。',
    ],
    status: '奥克兰 · 新西兰',
    role: '信息技术硕士在读',
  },
  en: {
    lines: [
      'Writing code, doing grad school, sometimes staring into space. Auckland.',
      'Building things that are interesting or useless or both.',
      'Believe good tools should be quiet.',
    ],
    status: 'Auckland · New Zealand',
    role: 'Master of Information Technology',
  },
};

const c = content[lang as keyof typeof content] || content.zh;
---

<section class="pt-32 pb-20 px-6 max-w-3xl">
  <div class="avatar-wrapper mb-8">
    <div class="avatar-ring">
      <div class="avatar-inner">
        <img src="/logo.jpg" alt="" class="avatar-img" />
        <div class="avatar-overlay"></div>
      </div>
    </div>
  </div>
  <div class="space-y-1.5 text-[var(--color-text-secondary)] leading-relaxed">
    {c.lines.map((line) => <p>{line}</p>)}
  </div>
  <div class="mt-8 flex flex-col gap-1 text-sm text-[var(--color-text-muted)]">
    <span>{c.status}</span>
    <span>{c.role}</span>
  </div>
</section>

<style>
  .avatar-wrapper {
    width: 88px;
    height: 88px;
  }
  .avatar-ring {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, var(--color-accent), var(--color-text-muted), var(--color-accent));
    mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #fff calc(100% - 3px));
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #fff calc(100% - 3px));
  }
  .avatar-inner {
    position: relative;
    width: 82px;
    height: 82px;
    border-radius: 50%;
    overflow: hidden;
    position: absolute;
    top: 3px;
    left: 3px;
  }
  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .avatar-overlay {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, transparent 40%, var(--color-bg) 100%);
    pointer-events: none;
  }
  .avatar-wrapper {
    position: relative;
  }
</style>

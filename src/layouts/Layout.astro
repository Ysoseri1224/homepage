---
import '../styles/global.css';

interface Props {
  title?: string;
  lang?: string;
}

const { title = 'why so serious', lang = 'zh' } = Astro.props;
const otherLang = lang === 'zh' ? 'en' : 'zh';
const otherLangLabel = lang === 'zh' ? 'EN' : '中';
const isZh = lang === 'zh';
const description = isZh
  ? 'ysoseri 的个人主页——全栈开发者，奥克兰大学信息技术硕士在读，记录技术、生活和思考。'
  : 'The personal homepage of ysoseri, a full-stack developer and Master of Information Technology student at the University of Auckland.';
const canonicalUrl = `https://ysoseri.us/${lang}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="zh-CN" href="https://ysoseri.us/zh/" />
    <link rel="alternate" hreflang="en" href="https://ysoseri.us/en/" />
    <link rel="alternate" hreflang="x-default" href="https://ysoseri.us/zh/" />
    <meta property="og:title" content={isZh ? 'ysoseri · 个人主页' : 'ysoseri · Personal homepage'} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://ysoseri.us/og-image.png" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={isZh ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={isZh ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={isZh ? 'ysoseri · 个人主页' : 'ysoseri · Personal homepage'} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://ysoseri.us/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500&family=Noto+Serif+SC:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      (function(){
        const s=localStorage.getItem('theme');
        const p=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';
        document.documentElement.dataset.theme=s||p;
      })();
    </script>
  </head>
  <body>
    <div id="cursor"></div>
    <div id="cursor-dot"></div>
    <div class="spotlight" id="spot"></div>

    <nav>
      <a class="logo" href={`/${lang}/`}>ysoseri</a>
      <div class="nav-right">
        <div class="dots-wrap">
          <div class="dots-trigger" id="dots-btn">
            <span></span><span></span><span></span>
          </div>
          <div class="dots-flyout" id="dflyout">
            <a class="flyout-item" href="https://blog.ysoseri.us" target="_blank">
              <span class="flyout-name" style="color:var(--t3)">blog</span>
            </a>
            <a class="flyout-item" href="https://tools.ysoseri.us" target="_blank">
              <span class="flyout-name" style="color:var(--t3)">tools</span>
            </a>
            <a class="flyout-item" href="https://travel.ysoseri.us" target="_blank">
              <span class="flyout-name">travel</span>
            </a>
            <a class="flyout-item" href="https://luckyrong.ysoseri.us" target="_blank">
              <span class="flyout-name">luckyrong</span>
            </a>
          </div>
        </div>

        <div class="nav-sep"></div>
        <a class="nav-btn" href={`/${otherLang}/`}>{otherLangLabel}</a>
        <div class="nav-sep"></div>
        <button class="nav-btn" id="theme-btn">☀ / ☾</button>
      </div>
    </nav>

    <slot />

    <footer class="page-footer">
      <div class="footer-copy">© 2026 · ysoseri.us</div>
      <div class="footer-copy">{lang === 'zh' ? '构建于 Cloudflare' : 'Built on Cloudflare'}</div>
    </footer>

    <script is:inline>
      const cursor = document.getElementById('cursor');
      const dot = document.getElementById('cursor-dot');
      const spot = document.getElementById('spot');
      let mx=0,my=0,cx=0,cy=0;

      document.addEventListener('mousemove',function(e){
        mx=e.clientX; my=e.clientY;
        dot.style.left=mx+'px'; dot.style.top=my+'px';
        spot.style.left=mx+'px'; spot.style.top=my+'px';
      });

      var glowEls=document.querySelectorAll('.page-wrap, nav, .page-footer');
      var glowR=40;
      var glowSpans=[];
      var visibleSpans=new Set();

      // IntersectionObserver 粗筛：只追踪视口内的 span
      var io=new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if(e.isIntersecting) visibleSpans.add(e.target);
          else visibleSpans.delete(e.target);
        });
      },{rootMargin:'100px'});

      function splitText(root){
        var walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
        var textNodes=[];
        while(walker.nextNode()) textNodes.push(walker.currentNode);
        textNodes.forEach(function(n){
          if(!n.textContent.trim()||n.parentNode.classList.contains('gc')) return;
          var frag=document.createDocumentFragment();
          for(var i=0;i<n.textContent.length;i++){
            var s=document.createElement('span');
            s.textContent=n.textContent[i];
            s.className='gc';
            frag.appendChild(s);
            glowSpans.push(s);
            io.observe(s);
          }
          n.parentNode.replaceChild(frag,n);
        });
      }
      glowEls.forEach(function(el){splitText(el);});
      new MutationObserver(function(muts){
        muts.forEach(function(m){
          m.addedNodes.forEach(function(n){
            if(n.nodeType===1){
              if(n.classList&&n.classList.contains('gc')){
                glowSpans.push(n);
                io.observe(n);
              }
              else if(n.querySelectorAll){
                n.querySelectorAll('.gc').forEach(function(s){
                  glowSpans.push(s);
                  io.observe(s);
                });
              }
            }
          });
        });
      }).observe(document.querySelector('.page-wrap'),{childList:true,subtree:true});

      function updateGlow(){
        visibleSpans.forEach(function(span){
          var r=span.getBoundingClientRect();
          if(r.width===0) return;
          var cx2=r.left+r.width/2;
          var cy2=r.top+r.height/2;
          var dist=Math.sqrt((mx-cx2)*(mx-cx2)+(my-cy2)*(my-cy2));
          if(dist<glowR) span.classList.add('glow');
          else span.classList.remove('glow');
        });
        requestAnimationFrame(updateGlow);
      }
      updateGlow();

      function lerp(a,b,t){return a+(b-a)*t;}
      (function anim(){
        cx=lerp(cx,mx,.3); cy=lerp(cy,my,.3);
        cursor.style.left=cx+'px'; cursor.style.top=cy+'px';
        requestAnimationFrame(anim);
      })();

      var onText=false;
      document.addEventListener('mousemove',function(e){
        var t=e.target;
        if(!t||!t.closest) return;
        var isLink=t.closest('a,button,.dots-trigger,.avatar');
        var isText=!isLink&&(t.classList.contains('gc')||t.closest('.footer-copy,.hero-tag,.panel-label,.snake-ph-label,.sb-label,.nav-btn,.logo'));
        if(isText&&!onText){onText=true;cursor.classList.add('on-text');dot.classList.add('on-text');}
        else if(!isText&&onText){onText=false;cursor.classList.remove('on-text');dot.classList.remove('on-text');}
      });
      document.querySelectorAll('a,button,.dots-trigger,.commit-item,.avatar').forEach(function(el){
        el.addEventListener('mouseenter',function(){cursor.classList.add('on-link');});
        el.addEventListener('mouseleave',function(){cursor.classList.remove('on-link');});
      });

      document.getElementById('dots-btn').addEventListener('click',function(){
        document.getElementById('dflyout').classList.toggle('open');
      });
      document.addEventListener('click',function(e){
        if(!e.target.closest('.dots-wrap')) document.getElementById('dflyout').classList.remove('open');
      });

      document.getElementById('theme-btn').addEventListener('click',function(){
        const t=document.documentElement.dataset.theme==='dark'?'light':'dark';
        document.documentElement.dataset.theme=t;
        localStorage.setItem('theme',t);
        document.querySelectorAll('.snake-img[data-light][data-dark]').forEach(function(img){
          img.src=t==='dark'?img.dataset.dark:img.dataset.light;
        });
      });

      // 初始化 snake SVG 匹配当前主题
      (function(){
        var t=document.documentElement.dataset.theme;
        document.querySelectorAll('.snake-img[data-light][data-dark]').forEach(function(img){
          img.src=t==='dark'?img.dataset.dark:img.dataset.light;
        });
      })();
    </script>
  </body>
</html>

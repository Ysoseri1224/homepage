---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import LangSwitch from '../components/LangSwitch.astro';
import SubdomainNav from '../components/SubdomainNav.astro';

interface Props {
  title: string;
  lang?: string;
}

const { title, lang = 'zh' } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Why so serious?</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;700&family=Noto+Serif+SC:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = stored || preferred;
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <!-- 噪点覆盖层 -->
    <div class="fixed inset-0 pointer-events-none z-50" style="opacity: var(--noise-opacity)">
      <svg width="100%" height="100%">
        <filter id="noise">
          <feTurbulence baseFrequency="0.7" numOctaves="4" type="fractalNoise" />
        </filter>
        <rect width="100%" height="100%" filter="url(#noise)" />
      </svg>
    </div>

    <!-- 右上角控件 -->
    <header class="fixed top-6 right-6 z-40 flex items-center gap-4">
      <LangSwitch lang={lang} />
      <ThemeToggle />
      <SubdomainNav lang={lang} />
    </header>

    <slot />
  </body>
</html>
